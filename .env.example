# =============================================================================
# Clinical Meeting Intelligence — environment template
# Copy to .env and adjust:  cp .env.example .env
# =============================================================================

# --- Embeddings (local, Hugging Face via sentence-transformers) ---
# Downloaded automatically on first API start (~130 MB for default).
# Any sentence-transformers model name works, e.g. all-MiniLM-L6-v2
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store (Qdrant) ---
# Docker Compose: http://qdrant:6333 (set automatically in compose)
# Local dev:       http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=meeting_chunks

# --- LLM provider (pick ONE via LLM_PROVIDER) ---
# Supported: ollama | openai | anthropic
# The RAG pipeline is provider-agnostic — swap with one env var.
LLM_PROVIDER=ollama

# Ollama (local, default — no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (set LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- RAG retrieval ---
RETRIEVAL_TOP_K=5
MAX_CONTEXT_TOKENS=3000
MAX_UPLOAD_BYTES=1048576

# --- Voice transcription (local faster-whisper / Hugging Face) ---
# Model sizes: tiny | base | small | medium | large-v3 | large-v3-turbo
# Downloaded automatically on first audio upload (~500 MB for small).
# Use tiny + cpu + int8 for fast laptops; large-v3-turbo + cuda for GPU.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
MAX_AUDIO_UPLOAD_BYTES=52428800
TRANSCRIPT_DEFAULT_SPEAKER=Speaker

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Optional: fix Hugging Face SSL on some Windows setups ---
# Uncomment and run setup.ps1, or set manually before starting the API:
# SSL_CERT_FILE=<path from: python -c "import certifi; print(certifi.where())">
# REQUESTS_CA_BUNDLE=<same as SSL_CERT_FILE>
